# Supabase Public Keys (safe for client side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server-Only Secret Keys (DO NOT EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Direct Connection URL (PostgreSQL / Supabase connection string)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Cron Job Protection Secret
CRON_SECRET=your-secure-cron-secret-token

# Clé secrète de chiffrement AES-256 pour les identifiants bancaires
ENCRYPTION_SECRET=your-super-secret-encryption-key-32-chars

# CoinGecko API Key (Optional free/pro tier key)
COINGECKO_API_KEY=your-coingecko-api-key

# Meria API Key (https://api.meria.com/v1)
MERIA_API_KEY=your-meria-api-key

# Public On-Chain Crypto Addresses (Optional default addresses for cold wallets)
ETH_ADDRESS=0x...
BTC_ADDRESS=bc1q...
DOGE_ADDRESS=D...
XRP_ADDRESS=r...

# Saxo OpenAPI (Saxo Bank - https://www.developer.saxo)
SAXO_APP_KEY=your-saxo-app-key
SAXO_APP_SECRET=your-saxo-app-secret
SAXO_REDIRECT_URI=http://localhost:3000/callback
SAXO_ENV=live # "live" ou "sim"
SAXO_ACCESS_TOKEN=your-saxo-access-token
SAXO_REFRESH_TOKEN=your-saxo-refresh-token

# Optionnel : spécifier directement les clés du compte PEA si plusieurs sous-comptes existent
SAXO_ACCOUNT_KEY=
SAXO_CLIENT_KEY=

# Amundi PEE (Épargne Salariale - Sopra Steria SOP.PA)
AMUNDI_PEE_QUANTITY=17
